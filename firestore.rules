rules_version = '2';
// قواعد حماية منصة نبض
// - كل عيادة معزولة تماماً عن غيرها
// - السكرتارية لا تطّلع على أي بيانات طبية
// - المالك (صاحب المنصة) يدير الاشتراكات فقط ولا يطّلع على بيانات المرضى
// - العيادة منتهية الاشتراك تصبح للقراءة فقط
// - لا حذف نهائي لأي سجل
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(uPath()).data; }
    function active() { return signedIn() && exists(uPath()) && me().active == true; }
    function inClinic(c) { return active() && me().clinicId == c; }
    function isStaff(c) { return inClinic(c) && me().role in ['doctor', 'secretary', 'nurse', 'accountant']; }
    function isNurse(c) { return inClinic(c) && me().role == 'nurse'; }
    function isAcct(c) { return inClinic(c) && me().role == 'accountant'; }
    // الممرض يقرأ الملف الطبي (عدا الملاحظات الخاصة) ويسجل المؤشرات الحيوية
    function canMed(c) { return isDoctor(c) || isNurse(c); }
    function isDoctor(c) { return inClinic(c) && me().role == 'doctor'; }
    function isAdmin(c) { return isDoctor(c) && me().get('admin', false) == true; }
    // الدور المخصّص: المسؤول يختار صلاحياته (perms)، والسجل الطبي له عرض فقط
    function isCustom(c) { return inClinic(c) && me().role == 'custom'; }
    function pm(c, k) { return isCustom(c) && me().get('perms', {}).get(k, false) == true; }
    function medR(c) { return isCustom(c) && me().get('perms', {}).get('med', 'none') == 'read'; }
    // من يقرأ قائمة المرضى من الأدوار المخصّصة
    function ptRead(c) { return pm(c, 'appts') || pm(c, 'patients') || pm(c, 'pay') || pm(c, 'fin') || pm(c, 'messages') || pm(c, 'reports') || pm(c, 'commissions') || medR(c); }
    // حصص الأطباء: المسؤول والمحاسب ومن لديه الصلاحية، والطبيب يرى حصته فقط
    function commAll(c) { return isAdmin(c) || isAcct(c) || pm(c, 'commissions'); }
    function myDoc(c, did) { return isDoctor(c) && me().get('doctorId', '') == did; }
    function validPerms(p) {
      return p is map && p.keys().hasOnly(['appts', 'patients', 'pay', 'fin', 'expenses', 'reports', 'inventory', 'messages', 'settings', 'audit', 'commissions', 'med'])
        && p.get('med', 'none') in ['none', 'read'];
    }
    function isPatient(c, pid) { return inClinic(c) && me().role == 'patient' && pid in me().patientIds; }
    function isOwner() { return signedIn() && exists(/databases/$(database)/documents/owners/$(request.auth.uid)); }
    function cl(c) { return get(/databases/$(database)/documents/clinics/$(c)).data; }
    function clinicOK(c) { return cl(c).status in ['trial', 'active'] && cl(c).expiresAt > request.time; }
    function feature(c, f) { return cl(c).features.get(f, false) == true; }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function bootPath() { return /databases/$(database)/documents/platform/bootstrap; }
    function bootstrapping() { return signedIn() && !exists(bootPath()) && existsAfter(bootPath()); }
    function newClinicBy(c) {
      return signedIn() && !exists(/databases/$(database)/documents/clinics/$(c))
        && getAfter(/databases/$(database)/documents/clinics/$(c)).data.ownerUid == request.auth.uid;
    }
    // الأقسام الطبية: الطبيب يكتب، والمريض يقرأ ملفه فقط
    // حساب المريض لا يُربط إلا بملف مريض له رقم الجوال نفسه (يمنع الموظف من ربط حساب بملفات مرضى آخرين)
    function patAfter(c, pid) { return getAfter(/databases/$(database)/documents/clinics/$(c)/patients/$(pid)).data; }
    function patPhoneOK(c, pid, phone) { return patAfter(c, pid).phone == phone; }
    function medSub(s) {
      return s in ['medical', 'visits', 'prescriptions', 'pregnancies', 'fertility', 'labs',
                   'dental', 'growth', 'vaccines', 'eye', 'physio', 'vitals', 'plans'];
    }

    // ---------- إعدادات المنصة ----------
    match /platform/config {
      allow read: if true;
      allow create: if bootstrapping();
      allow update: if isOwner();
      allow delete: if false;
    }
    match /platform/bootstrap {
      allow read: if true;
      allow create: if bootstrapping()
        && existsAfter(/databases/$(database)/documents/owners/$(request.auth.uid));
      allow update, delete: if false;
    }
    // نشاط العيادات لصاحب المنصة: أرقام فقط (آخر استخدام وعدد المرضى ومواعيد الشهر)، دون أي بيانات مرضى
    match /activity/{cid} {
      allow read: if isOwner();
      allow create, update: if (isStaff(cid) || isCustom(cid))
        && request.resource.data.keys().hasOnly(['lastAt', 'patients', 'apptsMonth', 'day'])
        && request.resource.data.patients is int && request.resource.data.apptsMonth is int
        && request.resource.data.day is string && request.resource.data.lastAt == request.time;
      allow delete: if false;
    }
    // سجل أعطال التطبيق: رسالة الخطأ ومكانه فقط (دون بيانات مرضى)، يقرؤه صاحب المنصة لإصلاحه بسرعة
    match /errors/{id} {
      allow read: if isOwner();
      allow create: if request.resource.data.keys().hasOnly(['msg', 'stack', 'route', 'role', 'cid', 'v', 'ua', 'at', 'n'])
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 1500
        && request.resource.data.route is string && request.resource.data.route.size() <= 80
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 160
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    // عدّاد زوار الموقع: لكل يوم مستند، والزيادة بمقدار 1 فقط، والقراءة لصاحب المنصة
    match /visits/{day} {
      allow read: if isOwner();
      allow create: if day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['views', 'uniq'])
        && request.resource.data.views == 1 && request.resource.data.uniq in [0, 1];
      allow update: if request.resource.data.keys().hasOnly(['views', 'uniq'])
        && request.resource.data.views == resource.data.views + 1
        && request.resource.data.uniq in [resource.data.uniq, resource.data.uniq + 1];
      allow delete: if false;
    }
    // عدّاد استهلاك Firestore التقريبي (أرقام فقط) لمقارنته بحد الخطة المجانية
    match /usage/{day} {
      allow read: if isOwner();
      allow create: if signedIn() && day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['r', 'w'])
        && request.resource.data.r is int && request.resource.data.w is int
        && request.resource.data.r >= 0 && request.resource.data.r < 200000 && request.resource.data.w >= 0 && request.resource.data.w < 50000;
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['r', 'w'])
        && request.resource.data.r is int && request.resource.data.w is int
        && request.resource.data.r >= resource.data.r && request.resource.data.r - resource.data.r < 200000
        && request.resource.data.w >= resource.data.w && request.resource.data.w - resource.data.w < 50000;
      allow delete: if false;
    }
    // عدّاد تنزيلات تطبيق أندرويد من الموقع: زيادة بمقدار 1 فقط
    match /downloads/{day} {
      allow read: if isOwner();
      allow create: if day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }
    match /owners/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create: if (bootstrapping() && request.auth.uid == uid) || isOwner();
      allow update, delete: if false;
    }

    // ---------- فهرس الدخول الموحد ----------
    // المفتاح بصمة (رقم الجوال + كلمة المرور)، فلا يمكن قراءته إلا لمن يعرف كلمة المرور. لا يُسمح بسرد المستندات.
    match /loginIdx/{h} {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if signedIn() && request.resource.data.keys().hasOnly(['e'])
        && request.resource.data.e is list && request.resource.data.e.size() <= 10;
    }

    // ---------- بيانات عامة لكل عيادة (صفحة الحجز والدخول) ----------
    match /slugs/{slug} {
      allow get: if true;
      allow list: if isOwner();
      allow create: if (newClinicBy(request.resource.data.cid)
                        && getAfter(/databases/$(database)/documents/clinics/$(request.resource.data.cid)).data.slug == slug)
                    || isOwner();
      allow update, delete: if isOwner();
    }
    match /publicClinics/{c} {
      allow get: if true;
      // دليل الأطباء: أي زائر يتصفح العيادات التي اختارت الظهور فقط
      allow list: if isOwner() || resource.data.get('listed', false) == true;
      allow create: if newClinicBy(c);
      allow update: if isAdmin(c) || pm(c, 'settings') || isOwner();
      allow delete: if false;
    }
    match /rxVerify/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if isDoctor(request.resource.data.clinicId)
        && clinicOK(request.resource.data.clinicId) && feature(request.resource.data.clinicId, 'qr');
      allow update, delete: if false;
    }

    // ---------- دفعات الاشتراك ----------
    match /subscriptionPayments/{id} {
      allow read: if isOwner() || isAdmin(resource.data.clinicId);
      allow create: if isAdmin(request.resource.data.clinicId) && request.resource.data.status == 'pending';
      allow update: if isOwner();
      allow delete: if false;
    }

    // ---------- الحسابات ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff(resource.data.clinicId) || isCustom(resource.data.clinicId) || isOwner());
      allow create: if
        (request.auth.uid == uid && request.resource.data.role == 'doctor' && request.resource.data.admin == true
          && newClinicBy(request.resource.data.clinicId))
        || (isAdmin(request.resource.data.clinicId) && clinicOK(request.resource.data.clinicId)
            && request.resource.data.role in ['secretary', 'doctor', 'nurse', 'accountant'] && request.resource.data.admin == false
            && !request.resource.data.keys().hasAny(['perms']))
        || (isAdmin(request.resource.data.clinicId) && clinicOK(request.resource.data.clinicId)
            && request.resource.data.role == 'custom' && request.resource.data.admin == false
            && validPerms(request.resource.data.perms) && request.resource.data.roleTitle is string && request.resource.data.roleTitle.size() <= 40)
        || ((isStaff(request.resource.data.clinicId) || pm(request.resource.data.clinicId, 'patients') || pm(request.resource.data.clinicId, 'appts'))
            && clinicOK(request.resource.data.clinicId)
            && request.resource.data.role == 'patient' && request.resource.data.get('admin', false) == false
            && request.resource.data.active == true
            && request.resource.data.patientIds is list && request.resource.data.patientIds.size() >= 1
            && patPhoneOK(request.resource.data.clinicId, request.resource.data.patientIds[0], request.resource.data.phone)
            && (request.resource.data.patientIds.size() == 1
                // إعادة تعيين كلمة المرور: الحساب الجديد يرث ملفات الحساب السابق للرقم نفسه فقط
                || request.resource.data.patientIds == get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/clinics/$(request.resource.data.clinicId)/phones/$(request.resource.data.phone)).data.patientUid)).data.patientIds));
      allow update: if
        (request.auth.uid == uid && onlyChanged(['mustChangePassword', 'consentAt', 'hideSensitive', 'fcmTokens', 'theme']))
        || (isAdmin(resource.data.clinicId) && resource.data.role in ['secretary', 'doctor', 'nurse', 'accountant']
            && resource.data.get('admin', false) == false
            && onlyChanged(['active', 'name', 'title', 'mustChangePassword']))
        || (isAdmin(resource.data.clinicId) && resource.data.role == 'custom'
            && onlyChanged(['active', 'name', 'title', 'mustChangePassword', 'perms', 'roleTitle'])
            && validPerms(request.resource.data.perms) && request.resource.data.roleTitle is string && request.resource.data.roleTitle.size() <= 40)
        || ((isStaff(resource.data.clinicId) || pm(resource.data.clinicId, 'patients') || pm(resource.data.clinicId, 'appts')) && resource.data.role == 'patient'
            && onlyChanged(['patientIds', 'active', 'mustChangePassword', 'lastPid'])
            && (request.resource.data.patientIds == resource.data.patientIds
                // إزالة ملفات فقط
                || resource.data.patientIds.toSet().hasAll(request.resource.data.patientIds.toSet())
                // إضافة ملف واحد فقط، رقم جواله مطابق لرقم الحساب
                || (request.resource.data.patientIds.size() == resource.data.patientIds.size() + 1
                    && request.resource.data.patientIds.toSet().hasAll(resource.data.patientIds.toSet())
                    && request.resource.data.patientIds.hasAny([request.resource.data.lastPid])
                    && patPhoneOK(resource.data.clinicId, request.resource.data.lastPid, resource.data.phone))));
      allow delete: if false;
    }

    // ---------- العيادة ----------
    match /clinics/{c} {
      allow read: if inClinic(c) || isOwner();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && !exists(uPath())
        && getAfter(uPath()).data.clinicId == c && getAfter(uPath()).data.admin == true
        && request.resource.data.status == 'trial' && request.resource.data.plan == 'trial'
        && request.resource.data.expiresAt <= request.time + duration.value(15, 'd')
        && request.resource.data.maxDoctors <= 3 && request.resource.data.maxStaff <= 3
        && !request.resource.data.keys().hasAny(['referralRewarded', 'referrals']);
      allow update: if isOwner()
        || (isAdmin(c) && clinicOK(c)
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['status', 'plan', 'expiresAt', 'features', 'maxDoctors', 'maxStaff', 'ownerUid', 'slug', 'referredBy', 'referralRewarded', 'referrals'])
            // تعدد الاختصاصات لباقة المراكز فقط
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['modules'])
                || feature(c, 'multiSpecialty') || request.resource.data.modules.size() <= 1
                || request.resource.data.modules.toSet().difference(['preg', 'gyn', 'cosm'].toSet()).size() == 0))
        // صلاحية «إعدادات العيادة» لدور مخصّص: كالمسؤول، دون الأطباء والاختصاصات
        || (pm(c, 'settings') && clinicOK(c)
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['status', 'plan', 'expiresAt', 'features', 'maxDoctors', 'maxStaff', 'ownerUid', 'slug', 'referredBy', 'referralRewarded', 'referrals', 'doctors', 'modules']))
        // أي طبيب في العيادة يحفظ وصفاته الجاهزة وأسماء الأدوية
        || (isDoctor(c) && clinicOK(c) && onlyChanged(['drugs', 'rxTemplates']));
      allow delete: if false;

      match /phones/{phone} {
        allow read: if isStaff(c) || pm(c, 'patients') || pm(c, 'appts');
        allow create, update: if (isStaff(c) || pm(c, 'patients') || pm(c, 'appts')) && clinicOK(c);
        allow delete: if false;
      }

      match /patients/{pid} {
        allow read: if isStaff(c) || isPatient(c, pid) || ptRead(c);
        allow create: if (isStaff(c) || pm(c, 'patients') || pm(c, 'appts')) && clinicOK(c);
        allow update: if clinicOK(c) && (((isStaff(c) || pm(c, 'patients'))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'phone'])
                || (getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.phone == request.resource.data.phone
                    && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.patientIds.hasAny([pid]))))
          || (isPatient(c, pid) && onlyChanged(['lastMsgAt', 'lastMsgFrom', 'updatedAt']))
          // الدور المخصّص: المواعيد تربط المريض بالطبيب، والرسائل تحدّث آخر رسالة
          || (pm(c, 'appts') && onlyChanged(['doctorIds', 'updatedAt']))
          || (pm(c, 'messages') && onlyChanged(['lastMsgAt', 'lastMsgFrom', 'updatedAt'])));
        allow delete: if false;

        match /{sub}/{d} {
          allow read: if (medSub(sub) && (canMed(c) || medR(c) || isPatient(c, pid)))
            || (sub == 'private' && isDoctor(c))
            || (sub in ['procedures', 'files'] && (canMed(c) || medR(c) || isPatient(c, pid)))
            || (sub == 'messages' && (isStaff(c) || pm(c, 'messages') || isPatient(c, pid)));
          allow create: if clinicOK(c) && (
            ((medSub(sub) || sub in ['private', 'procedures', 'files']) && isDoctor(c))
            || (sub == 'vitals' && isPatient(c, pid) && request.resource.data.source == 'home')
            || (sub == 'vitals' && isNurse(c))
            || (sub == 'files' && isPatient(c, pid) && request.resource.data.uploadedBy == 'patient')
            || (sub == 'messages' && (isStaff(c) || pm(c, 'messages')) && request.resource.data.from == 'clinic')
            || (sub == 'messages' && isPatient(c, pid) && request.resource.data.from == 'patient'));
          allow update: if clinicOK(c) && (
            ((medSub(sub) || sub in ['private', 'procedures', 'files']) && isDoctor(c))
            || (sub == 'procedures' && isPatient(c, pid) && resource.data.consentSignedAt == null
                && onlyChanged(['consentSignedAt', 'consentName']))
            || (sub == 'files' && isPatient(c, pid) && resource.data.uploadedBy == 'patient'
                && onlyChanged(['url', 'broken'])));
          allow delete: if false;

          // الملف الكامل للصورة أو المستند (يُحمَّل عند فتحه فقط)
          match /blob/{b} {
            allow read: if (sub == 'private' && isDoctor(c))
              || (sub == 'files' && (canMed(c) || medR(c) || isPatient(c, pid)));
            allow create: if clinicOK(c) && b == 'main'
              && request.resource.data.data is string && request.resource.data.data.size() < 1000000
              && ((sub in ['private', 'files'] && isDoctor(c))
                  || (sub == 'files' && isPatient(c, pid)
                      && get(/databases/$(database)/documents/clinics/$(c)/patients/$(pid)/files/$(d)).data.uploadedBy == 'patient'));
            allow update, delete: if false;
          }
        }
      }

      match /appointments/{a} {
        allow read: if isStaff(c) || isPatient(c, resource.data.patientId) || ptRead(c);
        allow create: if (isStaff(c) || pm(c, 'appts')) && clinicOK(c);
        allow update: if clinicOK(c) && (isStaff(c) || pm(c, 'appts')
          || (isPatient(c, resource.data.patientId)
              && (onlyChanged(['rating', 'ratingNote'])
                  || (onlyChanged(['status', 'cancelledBy']) && request.resource.data.status == 'cancelled')
                  // تأكيد الحضور من التطبيق
                  || (onlyChanged(['patientConfirm', 'patientConfirmAt']) && request.resource.data.patientConfirm == 'yes')
                  // تسجيل الحضور بمسح رمز QR على باب العيادة: الرمز يجب أن يطابق رمز العيادة الحالي
                  || (onlyChanged(['status', 'checkin', 'arrivedAt']) && resource.data.status == 'confirmed'
                      && request.resource.data.status == 'arrived'
                      && request.resource.data.checkin == get(/databases/$(database)/documents/clinics/$(c)/live/checkin).data.code))));
        allow delete: if false;
      }

      match /requests/{r} {
        allow read: if isStaff(c) || pm(c, 'appts') || isPatient(c, resource.data.patientId);
        allow create: if clinicOK(c) && (isStaff(c) || pm(c, 'appts')
          || (isPatient(c, request.resource.data.patientId) && request.resource.data.status == 'new'));
        allow update: if (isStaff(c) || pm(c, 'appts')) && clinicOK(c);
        allow delete: if false;
      }

      // طلبات الحجز من الصفحة العامة (بدون حساب)
      match /publicRequests/{r} {
        allow read, update: if isStaff(c) || pm(c, 'appts');
        allow create: if clinicOK(c) && feature(c, 'booking')
          && get(/databases/$(database)/documents/publicClinics/$(c)).data.bookingEnabled == true
          && request.resource.data.keys().hasOnly(['name', 'phone', 'date', 'time', 'doctorId', 'service', 'note', 'status', 'createdAt'])
          && request.resource.data.status == 'new'
          && request.resource.data.name is string && request.resource.data.name.size() < 80
          && request.resource.data.phone is string && request.resource.data.phone.size() < 20
          && request.resource.data.get('note', '').size() < 300;
        allow delete: if false;
      }

      // الأوقات المحجوزة فقط، بدون أسماء (لصفحة الحجز العامة)
      match /busy/{date} {
        allow read: if true;
        allow create, update: if (isStaff(c) || pm(c, 'appts')) && clinicOK(c);
        allow delete: if false;
      }

      match /payments/{p} {
        allow read: if isStaff(c) || isPatient(c, resource.data.patientId) || pm(c, 'pay') || pm(c, 'fin') || pm(c, 'reports') || pm(c, 'commissions');
        allow create: if (isStaff(c) || pm(c, 'pay') || pm(c, 'fin')) && clinicOK(c);
        allow update: if (isDoctor(c) || isAcct(c) || pm(c, 'fin')) && clinicOK(c);
        allow delete: if false;
      }

      match /inventory/{i} {
        allow read: if isStaff(c) || pm(c, 'inventory') || pm(c, 'appts');
        allow create, update: if (isStaff(c) || pm(c, 'inventory')) && clinicOK(c) && feature(c, 'inventory');
        // خصم المواد تلقائياً عند انتهاء موعد بيد دور مخصّص للمواعيد
        allow update: if pm(c, 'appts') && clinicOK(c) && feature(c, 'inventory') && onlyChanged(['qty', 'moves', 'updatedAt']);
        allow delete: if false;
      }

      match /waitlist/{w} {
        allow read: if isStaff(c) || pm(c, 'appts');
        allow create, update: if (isStaff(c) || pm(c, 'appts')) && clinicOK(c);
        allow delete: if false;
      }
      match /live/{d} {
        // لوحة الدور (أرقام فقط دون أسماء) يراها مرضى العيادة ليعرفوا كم شخصاً قبلهم؛ رمز الحضور للفريق فقط
        allow read: if isStaff(c) || pm(c, 'appts') || (d == 'queue' && inClinic(c));
        allow create, update: if (isStaff(c) || pm(c, 'appts')) && clinicOK(c);
        allow delete: if false;
      }

      // تنبيهات الحمل والإحصاءات الطبية: للأطباء فقط
      // مصاريف العيادة: للأطباء فقط
      match /expenses/{e} {
        allow read: if isDoctor(c) || isAcct(c) || pm(c, 'expenses');
        allow create, update: if (isDoctor(c) || isAcct(c) || pm(c, 'expenses')) && clinicOK(c);
        allow delete: if false;
      }

      // نسب كل طبيب (حسب تاريخ سريانها) ومبالغه الثابتة
      match /comm/{did} {
        allow read: if commAll(c) || myDoc(c, did);
        allow create, update: if (isAdmin(c) || pm(c, 'commissions')) && clinicOK(c)
          && request.resource.data.rates is list && request.resource.data.rates.size() <= 60;
        allow delete: if false;
      }
      // السلف وتسليم الحصص (لا حذف؛ الإلغاء بعلامة)
      match /commPay/{id} {
        allow read: if commAll(c) || myDoc(c, resource.data.doctorId);
        allow create: if commAll(c) && clinicOK(c)
          && request.resource.data.type in ['advance', 'payout']
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.doctorId is string && request.resource.data.by == request.auth.uid;
        allow update: if (isAdmin(c) || pm(c, 'commissions')) && clinicOK(c) && onlyChanged(['void', 'voidBy']) && request.resource.data.void == true;
        allow delete: if false;
      }

      match /pregAlerts/{d} {
        allow read: if isDoctor(c) || medR(c);
        allow create, update: if isDoctor(c) && clinicOK(c);
        allow delete: if false;
      }
      match /stats/{d} {
        allow read: if isDoctor(c) || pm(c, 'reports');
        allow create, update: if isDoctor(c) && clinicOK(c);
        allow delete: if false;
      }
      match /inbox/{d} {
        allow read, update: if isDoctor(c);
        allow create: if clinicOK(c) && (isDoctor(c) || isPatient(c, request.resource.data.patientId));
        allow delete: if false;
      }

      match /audit/{x} {
        allow read: if isAdmin(c) || pm(c, 'audit');
        allow create: if inClinic(c) && request.resource.data.by == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
