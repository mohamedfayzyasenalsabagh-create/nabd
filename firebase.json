{
  "firestore": { "rules": "firestore.rules" },
  "functions": { "source": "functions", "runtime": "nodejs20" },
  "hosting": {
    "site": "nabdsy",
    "public": ".",
    "ignore": [
      "firebase.json", "**/.*", "**/node_modules/**", "android/**", "functions/**", "tests/**",
      "*.md", "*.rules", "package.json", "package-lock.json", "LICENSE"
    ],
    "headers": [
      { "source": "sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(js|css|html|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "emulators": { "firestore": { "port": 8080 }, "ui": { "enabled": false } }
}
